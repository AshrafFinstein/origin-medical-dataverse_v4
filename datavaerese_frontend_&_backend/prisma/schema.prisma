// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectUserRole {
  NORMAL
  LEAD_ANALYST
  PROJECT_MASTER
}

enum SessionUserRole {
  ACTIVITY
  QUALITY_CONTROLLER
}

// GLOBAL MODELS
model Patient {
  id            String   @id
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  visits        Visit[]
}

model Visit {
  id           String               @id @default(uuid())
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  patient      Patient              @relation(fields: [patientId], references: [id])
  patientId    String
  rawResources RawResource[]
  visits       VisitsInRASessions[]

  @@index([patientId], type: BTree)
}

model RawResource {
  id                 String              @id
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  metadata           Json
  machine            String
  center             String
  visit              Visit               @relation(fields: [visitId], references: [id])
  visitId            String
  extractedResources ExtractedResource[]

  @@index([visitId], type: BTree)
}

model ExtractedResource {
  id                       String                           @id
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
  metadata                 Json
  thumbnailUrl             String
  rawResource              RawResource                      @relation(fields: [rawResourceId], references: [id])
  rawResourceId            String
  cESessions               ExtractedResourcesInCESessions[]
  dLSessions               ExtractedResourcesInDLSessions[]
  TaxonomyDataInDLSessions TaxonomyDataInDLSessions[]
  TimeSpentInExtractedResources TimeSpentInExtractedResources[]
  StructureDataInCESessions     StructureDataInCESessions[]
  ChildTaxonomy                  ChildTaxonomy[]
  ChildTaxonomyDataInDLSessions  ChildTaxonomyDataInDLSessions[]

  @@index([rawResourceId], type: BTree)
}

model Epic {
  id           String    @id @default(uuid())
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  name         String    @unique(sort: Asc) @db.VarChar(300)
  description  String    @db.VarChar(1000)
  projects     Project[]
}

model Project {
  id           String            @id @default(uuid())
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  name         String            @unique @db.VarChar(300)
  description  String            @db.VarChar(1000)
  epic         Epic              @relation(fields: [epicId], references: [id])
  deletedAt    DateTime?
  epicId       String
  users        UsersInProjects[]
  dLSessions   DLSession[]
  cESessions   CESession[]
  rASessions   RASession[]
  UserGroupInProjects   UserGroupInProjects[]

  @@index([epicId], type: BTree)
}

model UsersInProjects {
  userId    String
  project   Project         @relation(fields: [projectId], references: [id])
  projectId String
  userRole  ProjectUserRole

  @@id([userId, projectId, userRole])
}

model Label {
  id                             String                                   @id @default(uuid())
  createdAt                      DateTime                                 @default(now())
  updatedAt                      DateTime                                 @updatedAt
  name                           String                                   @unique(sort: Asc) @db.VarChar(300)
  abbreviation                   String                                   @db.VarChar(100)
  dLSessions                     LabelsInDLSessions[]
  extractedResourcesInDLSessions LabelsInExtractedResourcesInDLSessions[]

  @@unique([name, abbreviation])
}

model SessionLabel {
  id                             String                                   @id @default(uuid())
  createdAt                      DateTime                                 @default(now())
  deletedAt                      DateTime?                                @default(now())
  name                           String                                   @db.VarChar(300)
  description                    String                                   @db.VarChar(1000)
  colorCode                      String?                                  @db.VarChar(50)
  @@unique([name])
  dLSessions                     SessionLabelsInDLSessions[]
}

// DATA LABELLING SESSION MODELS
model DLSession {
  id                       String                           @id @default(uuid())
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
  name                     String                           @unique(sort: Asc) @db.VarChar(300)
  description              String                           @db.VarChar(1000)
  priority                 Int
  sop                      String[]
  project                  Project                          @relation(fields: [projectId], references: [id])
  deletedAt                DateTime?
  projectId                String
  sessionLabels            SessionLabelsInDLSessions[]
  users                    UsersInDLSessions[]
  extractedResources       ExtractedResourcesInDLSessions[]
  labels                   LabelsInDLSessions[]
  taxonomyInDLSessions     TaxonomyInDLSessions[]
  TaxonomyDataInDLSessions TaxonomyDataInDLSessions[]
  TimeSpentInDLSessions    TimeSpentInDLSessions[]
  TimeSpentInExtractedResources TimeSpentInExtractedResources[]
  UserGroupInDLSessions    UserGroupInDLSessions[]
  ChildTaxonomy            ChildTaxonomy[]
  ChildTaxonomyDataInDLSessions   ChildTaxonomyDataInDLSessions[]
  taxonomiesAnnotationsInDLSessions TaxonomiesAnnotationsInDLSessions[]
  dLSessionJsons           DLSessionJson[]
  dLSessionJsonVersions DLSessionJsonVersions[]
  deleteSessionRequests   DeleteSessionRequest[]
  userSessionAnnotationOrders UserSessionAnnotationOrder[]
  sessionStatusInDLSessions SessionStatusInDLSessions[]
  dLSessionLockHistory     DLSessionLockHistory[]
  @@index([projectId], type: BTree)
}

model DLSessionJson {
  id           String    @id @default(uuid())
  dLSession    DLSession @relation(fields: [dLSessionId], references: [id])
  dLSessionId  String
  filename     String    @db.VarChar(500)
  s3Key        String?
  createdAt    DateTime  @default(now())
  createdBy    String?
  @@index([dLSessionId], type: BTree)
}

model DeleteSessionRequest {
  id               String                     @id @default(uuid())
  dLSession        DLSession                  @relation(fields: [dLSessionId], references: [id])
  dLSessionId      String
  requestedBy      String
  reason           String
  rejectionReason  String?
  actionBy    String?    
  actionAt    DateTime? 
  status           DeleteSessionRequestStatus @default(PENDING)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
}

enum DeleteSessionRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model DLSessionJsonVersions {
  id String  @id @default(uuid())
  dLSession  DLSession      @relation(fields: [dLSessionId], references: [id])
  dLSessionId String
  purpose String
  majorVersion String
  minorVersion String
  s3Key String? 
  createdAt DateTime @default(now())
  createdBy String
  @@index([dLSessionId], type: BTree)
}

model UsersInDLSessions {
  userId      String
  dLSession   DLSession       @relation(fields: [dLSessionId], references: [id])
  dLSessionId String
  userRole    SessionUserRole

  @@id([userId, dLSessionId, userRole])
}

enum ExtractedResourceStatus {
  PENDING
  IN_REVIEW
  REJECTED
  ACCEPTED
}

model ExtractedResourcesInDLSessions {
  extractedResource   ExtractedResource                        @relation(fields: [extractedResourceId], references: [id])
  extractedResourceId String
  dLSession           DLSession                                @relation(fields: [dLSessionId], references: [id])
  dLSessionId         String
  status              ExtractedResourceStatus                  @default(PENDING)
  labels              LabelsInExtractedResourcesInDLSessions[]
  comment             String?
  markupData          String?

  @@id([extractedResourceId, dLSessionId])
  @@index([extractedResourceId], type: BTree)
  @@index([dLSessionId], type: BTree)
  @@index([status], type: Hash)
}

model LabelsInDLSessions {
  label       Label     @relation(fields: [labelId], references: [id])
  labelId     String
  dLSession   DLSession @relation(fields: [dLSessionId], references: [id])
  dLSessionId String

  @@id([labelId, dLSessionId])
  @@index([labelId], type: BTree)
  @@index([dLSessionId], type: BTree)
}

model SessionLabelsInDLSessions {
  sessionLabel   SessionLabel @relation(fields: [sessionLabelId], references: [id])
  sessionLabelId String
  dLSession      DLSession    @relation(fields: [dLSessionId], references: [id])
  dLSessionId    String
  isActive       Boolean        @default(true)
  @@id([sessionLabelId, dLSessionId])
  @@index([sessionLabelId], type: BTree)
  @@index([dLSessionId], type: BTree)
}

model LabelsInExtractedResourcesInDLSessions {
  id                             Int                            @id @default(autoincrement())
  label                          Label                          @relation(fields: [labelId], references: [id])
  labelId                        String
  extractedResourcesInDLSessions ExtractedResourcesInDLSessions @relation(fields: [extractedResourceId, dLSessionId], references: [extractedResourceId, dLSessionId])
  extractedResourceId            String
  dLSessionId                    String
  createdAt                      DateTime                       @default(now())
  updatedAt                      DateTime?                      @updatedAt
  deletedAt                      DateTime?
  createdBy                      String?
  updatedBy                      String?
  approvalLevel                  String?

  @@index([extractedResourceId], type: BTree)
  @@index([dLSessionId], type: BTree)
  @@index([labelId], type: BTree)
}

// CLINICAL EVALUATION SESSION MODELS
model CESession {
  id                          String                           @id @default(uuid())
  createdAt                   DateTime                         @default(now())
  updatedAt                   DateTime                         @updatedAt
  name                        String                           @unique(sort: Asc) @db.VarChar(300)
  description                 String                           @db.VarChar(1000)
  priority                    Int
  sop                         String[]
  deletedAt                   DateTime?
  resultTemplate              Json
  project                     Project                          @relation(fields: [projectId], references: [id])
  projectId                   String
  users                       UsersInCESessions[]
  extractedResources          ExtractedResourcesInCESessions[]
  taxonomyInCESessions        TaxonomyInCESessions[]
  structureGroupInCESessions StructureGroupInCESessions[]
  StructureDataInCESessions  StructureDataInCESessions[]
  UserGroupInCESessions      UserGroupInCESessions[]

  @@index([projectId], type: BTree)
}

model ExtractedResourcesInCESessions {
  extractedResource   ExtractedResource       @relation(fields: [extractedResourceId], references: [id])
  extractedResourceId String
  cESession           CESession               @relation(fields: [cESessionId], references: [id])
  cESessionId         String
  status              ExtractedResourceStatus @default(PENDING)
  comment             String

  @@id([extractedResourceId, cESessionId])
  @@index([extractedResourceId], type: BTree)
  @@index([cESessionId], type: BTree)
  @@index([status], type: Hash)
}

model UsersInCESessions {
  userId      String
  cESession   CESession       @relation(fields: [cESessionId], references: [id])
  cESessionId String
  userRole    SessionUserRole

  @@id([userId, cESessionId, userRole])
}

// REPORT ANALYSIS SESSION MODELS
model RASession {
  id          String               @id @default(uuid())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  name        String               @unique(sort: Asc) @db.VarChar(300)
  description String               @db.VarChar(1000)
  priority    Int
  sop         String[]
  template    Json
  project     Project              @relation(fields: [projectId], references: [id])
  projectId   String
  users       UsersInRASessions[]
  visits      VisitsInRASessions[]

  @@index([projectId], type: BTree)
}

model VisitsInRASessions {
  visit       Visit                   @relation(fields: [visitId], references: [id])
  visitId     String
  rASession   RASession               @relation(fields: [rASessionId], references: [id])
  rASessionId String
  index       Int
  content     Json
  status      ExtractedResourceStatus @default(PENDING)
  result      Json

  @@id([visitId, rASessionId])
  @@unique([rASessionId, index(sort: Asc)])
  @@index([rASessionId], type: BTree)
  @@index([visitId], type: BTree)
}

model UsersInRASessions {
  userId      String
  rASession   RASession       @relation(fields: [rASessionId], references: [id])
  rASessionId String
  userRole    SessionUserRole

  @@id([userId, rASessionId, userRole])
}

model Taxonomy {
  id                   String                 @id @default(uuid())
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  name                 String                 @db.VarChar(300)
  typesInTaxonomies    TypesInTaxonomy[]
  taxonomyInDLSessions TaxonomyInDLSessions[]
  taxonomyInCESessions TaxonomyInCESessions[]
  taxonomiesAnnotationsInDLSessions TaxonomiesAnnotationsInDLSessions[]
  userSessionAnnotationOrders UserSessionAnnotationOrder[]
}

model ChildTaxonomy {
  id                            String                        @id @default(uuid())
  name                          String                        @db.VarChar(300)
  dLSession                     DLSession                     @relation(fields: [dLSessionId], references: [id])
  dLSessionId                   String

  extractedResource             ExtractedResource             @relation(fields: [extractedResourceId], references: [id])
  extractedResourceId           String
  taxonomiesAnnotationsInDLSessions TaxonomiesAnnotationsInDLSessions   @relation(fields: [taxonomiesAnnotationsInDLSessionsId], references: [id])
  taxonomiesAnnotationsInDLSessionsId String
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt
  deletedAt                     DateTime?

  ChildTaxonomyDataInDLSessions ChildTaxonomyDataInDLSessions[]
  @@unique([name, dLSessionId, extractedResourceId,taxonomiesAnnotationsInDLSessionsId, deletedAt])
  @@index([dLSessionId, taxonomiesAnnotationsInDLSessionsId, deletedAt], map: "idx_ChildTaxonomy_session_tax_deleted")
}

model TaxonomyType {
  id                       String                     @id @default(uuid())
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  deletedAt                DateTime?                 
  name                     String                     @unique(sort: Asc) @db.VarChar(300)
  colorCode                String?                   
  annotations              Annotation[]
}

model TypesInTaxonomy {
  id                       String                     @id @default(uuid())
  colorCode                String                     @db.VarChar(300)
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  taxonomy                 Taxonomy                   @relation(fields: [taxonomyId], references: [id])
  taxonomyId               String
  deletedAt                DateTime?
  deletedBy                String?
  annotation                Annotation                @relation(fields: [annotationId], references: [id])
  annotationId              String
  
}

model TaxonomyInDLSessions {
  id          String    @id @default(uuid())
  dLSession   DLSession @relation(fields: [dLSessionId], references: [id])
  dLSessionId String
  taxonomy    Taxonomy  @relation(fields: [taxonomyId], references: [id])
  taxonomyId  String
}

model TaxonomyInCESessions {
  id          String    @id @default(uuid())
  cESession   CESession @relation(fields: [cESessionId], references: [id])
  cESessionId String
  taxonomy    Taxonomy  @relation(fields: [taxonomyId], references: [id])
  taxonomyId  String
}

model TaxonomyDataInDLSessions {
  id                  String            @id @default(uuid())
  dLSession           DLSession         @relation(fields: [dLSessionId], references: [id])
  dLSessionId         String
  extractedResource   ExtractedResource @relation(fields: [extractedResourceId], references: [id])
  extractedResourceId String
  typesInTaxonomyId String
  taxonomiesAnnotationsInDLSessions TaxonomiesAnnotationsInDLSessions   @relation(fields: [taxonomiesAnnotationsInDLSessionsId], references: [id])
  taxonomiesAnnotationsInDLSessionsId String
  taxonomyData        Json
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  deletedAt           DateTime?
  createdBy           String
  updatedBy           String

  @@index([dLSessionId, taxonomiesAnnotationsInDLSessionsId, deletedAt], map: "idx_TaxonomyDataInDL_session_tax_deleted")
  @@index([taxonomiesAnnotationsInDLSessionsId, deletedAt], map: "idx_TaxonomyDataInDL_tax_deleted")
}

model ChildTaxonomyDataInDLSessions {
  id                      String                  @id @default(uuid())
  taxonomyData            Json
  index                   Int
  childTaxonomy           ChildTaxonomy           @relation(fields: [childTaxonomyId], references: [id])
  childTaxonomyId         String
  dLSession               DLSession               @relation(fields: [dLSessionId], references: [id])
  dLSessionId             String
  extractedResource       ExtractedResource       @relation(fields: [extractedResourceId], references: [id])
  extractedResourceId     String
  taxonomiesAnnotationsInDLSessions TaxonomiesAnnotationsInDLSessions   @relation(fields: [taxonomiesAnnotationsInDLSessionsId], references: [id])
  taxonomiesAnnotationsInDLSessionsId String
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  deletedAt               DateTime?
  createdBy               String
  updatedBy               String

  @@index([dLSessionId, taxonomiesAnnotationsInDLSessionsId, deletedAt], map: "idx_ChildTaxonomyDataInDL_session_tax_deleted")
  @@index([childTaxonomyId, deletedAt], map: "idx_ChildTaxonomyDataInDL_child_deleted")
}

model UserSessionAnnotationOrder {
  id        String   @id @default(uuid())
  userId    String
  dLSessionId String
  annotationId String?  // Nullable for taxonomy orders
  taxonomyId String?
  order     Int
  taxonomyOrder Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  session    DLSession @relation(fields: [dLSessionId], references: [id])
  annotation TaxonomiesAnnotationsInDLSessions? @relation(fields: [annotationId], references: [id])
  taxonomy  Taxonomy? @relation(fields: [taxonomyId], references: [id])

  @@index([dLSessionId])
  @@index([userId])   // For taxonomy orders
}

model TimeSpentInDLSessions {
  id          String    @id @default(uuid())
  userId      String
  dLSession   DLSession @relation(fields: [dLSessionId], references: [id])
  dLSessionId String
  startTime   DateTime
  endTime     DateTime  @default(now())
}

model TimeSpentInExtractedResources {
  id                  String            @id @default(uuid())
  userId              String
  extractedResource   ExtractedResource @relation(fields: [extractedResourceId], references: [id])
  extractedResourceId String
  dLSession           DLSession         @relation(fields: [dLSessionId], references: [id])
  dLSessionId         String
  startTime           DateTime
  endTime             DateTime          @default(now())
  @@index([dLSessionId], type: BTree)
  @@index([extractedResourceId], type: BTree)
  @@index([userId], type: BTree)
}

model SessionStatus {
  id          String    @id @default(uuid())
  name        String
  description String
  colorCode   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  sessionStatusInDLSessions SessionStatusInDLSessions[]
}

model SessionStatusInDLSessions {
  id          String    @id @default(uuid())
  dLSession   DLSession @relation(fields: [dLSessionId], references: [id])
  dLSessionId String
  sessionStatus SessionStatus @relation(fields: [sessionStatusId], references: [id])
  sessionStatusId String
  isActive      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ApprovalMatrix {
  id               String         @id @default(uuid())
  sessionId        String?
  sessionTypeId    Int?
  toUserId         String
  approvalLevel    Int
  approvalGroup    Int
  userGroup        UserGroup?     @relation(fields: [userGroupId], references: [id])
  userGroupId      String?
  isParallel       Boolean        @default(false)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  createdBy        String
  updatedAt        DateTime       @updatedAt
  updatedBy        String?
}

model UserApproval {
  id                     String         @id @default(uuid())
  sessionId              String?
  approvalModuleUniqueId String
  approvalLevel          Int
  approvalUserId         String
  approvalStatusId       String?
  isCurrApprover         Boolean
  isNextApprover         Boolean
  isReSubmitApprover     Boolean
  isActive               Boolean        @default(true)
  createdAt              DateTime       @default(now())
  createdBy              String
  updatedAt              DateTime       @updatedAt
  updatedBy              String?
}

model StructureGroups {
  id                          String                        @id @default(uuid())
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  name                        String                        @unique(sort: Asc) @db.VarChar(300)
  StructureInStructureGroup   StructureInStructureGroup[]
  structureGroupInCESessions StructureGroupInCESessions[]
}

model StructureInStructureGroup {
  id               String          @id @default(uuid())
  name             String          @db.VarChar(300)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  StructureGroups  StructureGroups @relation(fields: [structureGroupId], references: [id])
  structureGroupId String
  StructureDataInCESessions StructureDataInCESessions[]
}

model StructureGroupInCESessions {
  id               String          @id @default(uuid())
  cESession        CESession       @relation(fields: [cESessionId], references: [id])
  cESessionId      String
  structureGroups  StructureGroups @relation(fields: [structureGroupId], references: [id])
  structureGroupId String
  StructureDataInCESessions StructureDataInCESessions[]
}

model StructureDataInCESessions {
  id                           String                      @id @default(uuid())
  cESession                    CESession                   @relation(fields: [cESessionId], references: [id])
  cESessionId                  String
  extractedResource            ExtractedResource           @relation(fields: [extractedResourceId], references: [id])
  extractedResourceId          String
  structureInStructureGroup    StructureInStructureGroup   @relation(fields: [structureInStructureGroupId], references: [id])
  structureInStructureGroupId  String
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt
  deletedAt                    DateTime?
  createdBy                    String
  updatedBy                    String
  StructureGroupInCESessions   StructureGroupInCESessions? @relation(fields: [structureGroupInCESessionsId], references: [id])
  structureGroupInCESessionsId String?
}

model UserGroup {
  id                           String                                   @id @default(uuid())
  groupName                    String                                   @unique(sort: Asc) @db.VarChar(300)
  description                  String                                   @db.VarChar(1000)
  createdAt                    DateTime                                 @default(now())
  updatedAt                    DateTime                                 @updatedAt
  deletedAt                    DateTime?
  createdBy                    String?
  updatedBy                    String?
  usersInGroup                 UsersInUserGroup[]
  UserGroupInProjects          UserGroupInProjects[]
  UserGroupInDLSessions        UserGroupInDLSessions[]
  UserGroupInCESessions        UserGroupInCESessions[]
  ApprovalMatrix               ApprovalMatrix[]
}

model UsersInUserGroup {
  id             String            @id @default(uuid())
  userId         String
  userGroup      UserGroup         @relation(fields: [userGroupId], references: [id])
  userGroupId    String
  userRole       ProjectUserRole    
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  @@unique([ id, userId, userGroupId, userRole])
}
 
model UserGroupInProjects {
  id             String                            @id @default(uuid())
  userGroup      UserGroup                         @relation(fields: [userGroupId], references: [id])
  userGroupId    String
  project        Project                           @relation(fields: [projectId], references: [id])
  projectId      String
  createdAt      DateTime                          @default(now())
  updatedAt      DateTime                          @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  @@unique([id, userGroupId, projectId])
}
 
model UserGroupInDLSessions {
  id             String                            @id @default(uuid())
  userGroup      UserGroup                         @relation(fields: [userGroupId], references: [id])
  userGroupId    String
  dLSession      DLSession                         @relation(fields: [dLSessionId], references: [id])
  dLSessionId    String
  userRole       SessionUserRole
  createdAt      DateTime                          @default(now())
  updatedAt      DateTime                          @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  @@unique([id, userGroupId, dLSessionId, userRole])
}

model UserGroupInCESessions {
  id             String                            @id @default(uuid())
  userGroup      UserGroup                         @relation(fields: [userGroupId], references: [id])
  userGroupId    String
  cESession      CESession                         @relation(fields: [cESessionId], references: [id])
  cESessionId    String
  userRole       SessionUserRole
  createdAt      DateTime                          @default(now())
  updatedAt      DateTime                          @updatedAt
  deletedAt      DateTime?
  createdBy      String?
  updatedBy      String?

  @@unique([id, userGroupId, cESessionId, userRole])
}
model ProjectCode {
  id                       String                     @id @default(uuid())
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  name                     String                     @unique(sort: Asc) @db.VarChar(300)
}

model SubProjectCode {
  id                       String                     @id @default(uuid())
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  name                     String                     @unique(sort: Asc) @db.VarChar(300)
}

model UseCaseCode {
  id                       String                     @id @default(uuid())
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  name                     String                     @unique(sort: Asc) @db.VarChar(300)
}

model AnatomyPlaneCode {
  id                       String                     @id @default(uuid())
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  name                     String                     @unique(sort: Asc) @db.VarChar(300)
}

model CenterCode {
  id                       String                     @id @default(uuid())
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  name                     String                     @unique(sort: Asc) @db.VarChar(300)
}

model UserTypeCode {
  id                       String                     @id @default(uuid())
  createdAt                DateTime                   @default(now())
  updatedAt                DateTime                   @updatedAt
  name                     String                     @unique(sort: Asc) @db.VarChar(300)
}

model UserRoles {
  id                      String                     @id @default(uuid()) @unique()
  name                    String                     @unique() @db.VarChar(300)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  deletedAt               DateTime?
  createdBy               String
  updatedBy               String
 
  RoleModuleActionMapping RoleModuleActionMapping[]
  UserRoleMapping         UserRoleMapping[]
}

model Modules {
  id                      String                     @id @default(uuid()) @unique()
  name                    String                     @unique() @db.VarChar(300)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  deletedAt               DateTime?
  createdBy               String
  updatedBy               String
 
  ModuleActionMapping     ModuleActionMapping[]
}

model Actions {
  id                      String                     @id @default(uuid()) @unique()
  name                    String                     @unique() @db.VarChar(300)
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  deletedAt               DateTime?
  createdBy               String
  updatedBy               String
 
  ModuleActionMapping     ModuleActionMapping[]
}

model ModuleActionMapping {
  id                      String                     @id @default(uuid()) @unique()
  moduleId                String
  actionId                String
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  deletedAt               DateTime?
  createdBy               String
  updatedBy               String
 
  Modules                 Modules?                   @relation(fields: [moduleId], references: [id])
  Actions                 Actions?                   @relation(fields: [actionId], references: [id])
 
  RoleModuleActionMapping RoleModuleActionMapping[]
}

model RoleModuleActionMapping {
  id                            String                          @id @default(uuid()) @unique()
  roleId                        String
  moduleActionMappingId         String
  createdAt                     DateTime                        @default(now())
  updatedAt                     DateTime                        @updatedAt
  deletedAt                     DateTime?
  createdBy                     String
  updatedBy                     String
 
  ModuleActionMapping           ModuleActionMapping             @relation(fields: [moduleActionMappingId], references: [id])
  Roles                         UserRoles                       @relation(fields: [roleId], references: [id])
}

model UserRoleMapping {
  id                             String                     @id @default(uuid()) @unique()
  userId                         String                     
  roleId                         String
  createdAt                      DateTime                   @default(now())
  updatedAt                      DateTime                   @updatedAt
  deletedAt                      DateTime?
  createdBy                      String
  updatedBy                      String
 
  UserRoles                      UserRoles                  @relation(fields: [roleId], references: [id])

  @@index([userId])
  @@index([roleId])
}


// annotation 

model Annotation {
  id                           String    @id @default(uuid())
  name                         String     @db.VarChar(300)
  taxonomyType                 TaxonomyType               @relation(fields: [taxonomyTypeId], references: [id])
  taxonomyTypeId               String
  colorCode                    String?   
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt
  deletedAt                    DateTime?
  createdBy                    String
  updatedBy                    String  
  typesInTaxonomies        TypesInTaxonomy[]
  taxonomiesAnnotationsInDLSessions TaxonomiesAnnotationsInDLSessions[]
  abbreviation                 String    @db.VarChar(300)
 @@unique([name], map: "unique_annotation_name")
 @@unique([abbreviation], map: "unique_annotation_abbreviation")
}

model TaxonomiesAnnotationsInDLSessions {
  id           String     @id @default(uuid())
  dLSession    DLSession  @relation(fields: [dLSessionId], references: [id])
  dLSessionId  String
  taxonomy     Taxonomy   @relation(fields: [taxonomyId], references: [id])
  taxonomyId   String
  annotation   Annotation @relation(fields: [annotationId], references: [id])
  changeAppearance Boolean                           @default(false)
  annotationId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?
  deletedBy    String?
  TaxonomyDataInDLSessions TaxonomyDataInDLSessions[]
  ChildTaxonomyDataInDLSessions ChildTaxonomyDataInDLSessions[]
  ChildTaxonomy           ChildTaxonomy[]
  userSessionAnnotationOrders UserSessionAnnotationOrder[]

  @@index([dLSessionId], type: BTree)
  @@index([taxonomyId], type: BTree)
  @@index([annotationId], type: BTree)
}

model DLSessionLockHistory {
  id            String      @id @default(uuid())
  dLSession     DLSession   @relation(fields: [dLSessionId], references: [id])
  dLSessionId   String
  isLocked      Boolean     @default(false)
  lockReason    String?     @db.VarChar(500)
  lockedAt      DateTime?
  lockedBy      String?
  unlockReason  String?     @db.VarChar(500)
  unlockedAt    DateTime?
  unlockedBy    String?
  deletedAt     DateTime?
  @@index([dLSessionId], type: BTree)
}