{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server: Nuxt",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/nuxi/bin/nuxi.mjs",
      "args": [
        "dev"
      ],
      "console": "integratedTerminal",
      "env": {
        "NUXT_PORT": "3000"
      },
      "sourceMaps": true
    },
    {
      "name": "Client: Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}",
      "sourceMapPathOverrides": {
        "webpack:///*": "${webRoot}/*"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack: Nuxt + Chrome",
      "configurations": [
        "Server: Nuxt",
        "Client: Chrome"
      ]
    }
  ]
}