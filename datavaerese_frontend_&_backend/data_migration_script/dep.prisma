generator client {
  provider = "prisma-client-js"
  output   = "./generated/dep_client"
}

datasource db {
  provider = "postgresql"
  url      = ""
}

model alembic_version {
  version_num String @id(map: "alembic_version_pkc") @db.VarChar(32)
}

model extracted_resource_labels {
  extracted_resource_id String
  label_id              String
  extracted_resources   extracted_resources @relation(fields: [extracted_resource_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  labels                labels              @relation(fields: [label_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([extracted_resource_id, label_id])
}

model extracted_resources {
  id                        String                      @id @default(uuid())
  created_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  resource_path             String                      @db.VarChar
  filetype                  resourcetype
  feature                   Json?
  raw_resource_id           String                      @db.VarChar
  patient_id                String                      @db.VarChar
  session_id                String?                     @db.Uuid
  sessions                  sessions?                   @relation(fields: [session_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  extracted_resource_labels extracted_resource_labels[]

  @@unique([resource_path, session_id])
}

model labels {
  id                        String                      @id @default(uuid())
  created_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  updated_at                DateTime?                   @default(now()) @db.Timestamptz(6)
  name                      String                      @unique @db.VarChar(50)
  abbreviation              String                      @db.VarChar(10)
  extracted_resource_labels extracted_resource_labels[]
  session_labels            session_labels[]
}

model session_labels {
  session_id String   @db.Uuid
  label_id   String   @db.Uuid
  labels     labels   @relation(fields: [label_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sessions   sessions @relation(fields: [session_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([session_id, label_id])
}

model sessions {
  id                  String                @id @default(uuid())
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @default(now()) @db.Timestamptz(6)
  name                String                @db.VarChar(50)
  description         String?               @db.VarChar
  user_id             String                @db.VarChar
  extracted_resources extracted_resources[]
  session_labels      session_labels[]

  @@unique([name, user_id])
}

enum resourcetype {
  DICOM
  PDF
  ZIP
  IMAGE
}
