// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = ""
}

enum ProjectUserRole {
  NORMAL
  LEAD_ANALYST
  PROJECT_MASTER
}

enum SessionUserRole {
  ACTIVITY
  QUALITY_CONTROLLER
}

// GLOBAL MODELS
model Patient {
  id        String   @id
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visits    Visit[]
}

model Visit {
  id                 String               @id @default(uuid())
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  patient            Patient              @relation(fields: [patientId], references: [id])
  patientId          String
  rawResources       RawResource[]
  VisitsInRASessions VisitsInRASessions[]
}

model RawResource {
  id                 String              @id
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  metadata           Json
  machine            String
  center             String
  visit              Visit               @relation(fields: [visitId], references: [id])
  visitId            String
  extractedResources ExtractedResource[]
}

model ExtractedResource {
  id            String                           @id
  createdAt     DateTime                         @default(now())
  updatedAt     DateTime                         @updatedAt
  metadata      Json
  thumbnailUrl  String
  rawResource   RawResource                      @relation(fields: [rawResourceId], references: [id])
  rawResourceId String
  cESessions    ExtractedResourcesInCESessions[]
  dLSessions    ExtractedResourcesInDLSessions[]
}

model Epic {
  id          String    @id @default(uuid())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  name        String    @unique @db.VarChar(300)
  description String    @db.VarChar(1000)
  projects    Project[]
}

model Project {
  id          String            @id @default(uuid())
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  name        String            @unique @db.VarChar(300)
  description String            @db.VarChar(1000)
  epic        Epic              @relation(fields: [epicId], references: [id])
  epicId      String
  users       UsersInProjects[]
  dLSessions  DLSession[]
  cESessions  CESession[]
  rASessions  RASession[]
}

model UsersInProjects {
  userId    String
  project   Project         @relation(fields: [projectId], references: [id])
  projectId String
  userRole  ProjectUserRole

  @@id([userId, projectId, userRole])
}

model Label {
  id                             String                                   @id @default(uuid())
  createdAt                      DateTime                                 @default(now())
  updatedAt                      DateTime                                 @updatedAt
  name                           String                                   @db.VarChar(300)
  abbreviation                   String                                   @db.VarChar(100)
  dLSessions                     LabelsInDLSessions[]
  extractedResourcesInDLSessions LabelsInExtractedResourcesInDLSessions[]
}

// DATA LABELLING SESSION MODELS
model DLSession {
  id                 String                           @id @default(uuid())
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt
  name               String                           @db.VarChar(300)
  description        String                           @db.VarChar(1000)
  priority           Int
  sop                String[]
  project            Project                          @relation(fields: [projectId], references: [id])
  projectId          String
  users              UsersInDLSessions[]
  extractedResources ExtractedResourcesInDLSessions[]
  labels             LabelsInDLSessions[]
}

model UsersInDLSessions {
  userId      String
  dLSession   DLSession       @relation(fields: [dLSessionId], references: [id])
  dLSessionId String
  userRole    SessionUserRole

  @@id([userId, dLSessionId, userRole])
}

enum ExtractedResourceStatus {
  PENDING
  IN_REVIEW
  REJECTED
  ACCEPTED
}

model ExtractedResourcesInDLSessions {
  extractedResource   ExtractedResource                        @relation(fields: [extractedResourceId], references: [id])
  extractedResourceId String
  dLSession           DLSession                                @relation(fields: [dLSessionId], references: [id])
  dLSessionId         String
  status              ExtractedResourceStatus                  @default(PENDING)
  labels              LabelsInExtractedResourcesInDLSessions[]

  @@id([extractedResourceId, dLSessionId])
}

model LabelsInDLSessions {
  label       Label     @relation(fields: [labelId], references: [id])
  labelId     String
  dLSession   DLSession @relation(fields: [dLSessionId], references: [id])
  dLSessionId String

  @@id([labelId, dLSessionId])
}

model LabelsInExtractedResourcesInDLSessions {
  label                          Label                          @relation(fields: [labelId], references: [id])
  labelId                        String
  extractedResourcesInDLSessions ExtractedResourcesInDLSessions @relation(fields: [extractedResourceId, dLSessionId], references: [extractedResourceId, dLSessionId])
  extractedResourceId            String
  dLSessionId                    String

  @@id([labelId, extractedResourceId, dLSessionId])
}

// CLINICAL EVALUATION SESSION MODELS
model CESession {
  id                 String                           @id @default(uuid())
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt
  name               String                           @db.VarChar(300)
  description        String                           @db.VarChar(1000)
  priority           Int
  sop                String[]
  resultTemplate     Json
  project            Project                          @relation(fields: [projectId], references: [id])
  projectId          String
  users              UsersInCESessions[]
  extractedResources ExtractedResourcesInCESessions[]
}

model ExtractedResourcesInCESessions {
  extractedResource   ExtractedResource       @relation(fields: [extractedResourceId], references: [id])
  extractedResourceId String
  cESession           CESession               @relation(fields: [cESessionId], references: [id])
  cESessionId         String
  index               Int
  status              ExtractedResourceStatus @default(PENDING)
  result              Json

  @@id([extractedResourceId, cESessionId])
  @@unique([cESessionId, index])
}

model UsersInCESessions {
  userId      String
  cESession   CESession       @relation(fields: [cESessionId], references: [id])
  cESessionId String
  userRole    SessionUserRole

  @@id([userId, cESessionId, userRole])
}

// REPORT ANALYSIS SESSION MODELS
model RASession {
  id          String               @id @default(uuid())
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  name        String               @db.VarChar(300)
  description String               @db.VarChar(1000)
  priority    Int
  sop         String[]
  template    Json
  project     Project              @relation(fields: [projectId], references: [id])
  projectId   String
  users       UsersInRASessions[]
  visits      VisitsInRASessions[]
}

model VisitsInRASessions {
  visit       Visit                   @relation(fields: [visitId], references: [id])
  visitId     String
  rASession   RASession               @relation(fields: [rASessionId], references: [id])
  rASessionId String
  index       Int
  content     Json
  status      ExtractedResourceStatus @default(PENDING)
  result      Json

  @@id([visitId, rASessionId])
  @@unique([rASessionId, index])
}

model UsersInRASessions {
  userId      String
  rASession   RASession       @relation(fields: [rASessionId], references: [id])
  rASessionId String
  userRole    SessionUserRole

  @@id([userId, rASessionId, userRole])
}
