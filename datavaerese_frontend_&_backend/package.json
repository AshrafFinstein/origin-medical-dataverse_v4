{
  "name": "dataverse",
  "private": true,
  "scripts": {
    "prepare": "nuxi prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxi typecheck",
    "build": "APP_ENV=build nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "prisma:inline": "cp ./node_modules/.prisma/client/*.js ./node_modules/@prisma/client",
    "prisma:migrate": "prisma migrate deploy && npm run prisma:inline",
    "prisma:migrate:dev": "prisma migrate dev && npm run prisma:inline",
    "prisma:generate": "prisma generate && npm run prisma:inline",
    "data:populate": "ts-node data_migration_script/index.ts",
    "test:unit": "vitest"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@auth0/auth0-spa-js": "^2.0.8",
    "@aws-sdk/client-s3": "^3.359.0",
    "@aws-sdk/s3-request-presigner": "^3.359.0",
    "@hapi/iron": "^7.0.1",
    "@prisma/client": "^4.16.2",
    "@trpc/client": "^10.38.0",
    "@trpc/server": "^10.38.0",
    "canvas": "^2.11.2",
    "cookie": "^0.5.0",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "husky": "^8.0.3",
    "konva": "^9.2.0",
    "luxon": "^3.3.0",
    "minimist": "^1.2.8",
    "node-cron": "^3.0.2",
    "sortablejs": "^1.15.6",
    "streamsaver": "^2.0.6",
    "superjson": "^1.13.1",
    "trpc-nuxt": "^0.10.12",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "winston-transport": "^4.6.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^0.39.5",
    "@css-render/vue3-ssr": "^0.15.12",
    "@faker-js/faker": "^9.9.0",
    "@nuxt/test-utils": "^3.5.3",
    "@nuxtjs/tailwindcss": "^6.8.0",
    "@owja/ioc": "^2.0.0-alpha.7",
    "@types/auth0": "^3.3.3",
    "@types/cookie": "^0.5.1",
    "@types/luxon": "^3.3.0",
    "@types/minimist": "^1.2.2",
    "@types/node": "20.3.1",
    "@types/offscreencanvas": "^2019.7.0",
    "@types/streamsaver": "^2.0.1",
    "@vueuse/core": "^10.2.0",
    "@vueuse/nuxt": "^10.2.0",
    "auth0": "^3.4.0",
    "axios": "^1.13.5",
    "c8": "^8.0.0",
    "commander": "^14.0.3",
    "glob": "^13.0.2",
    "husky": "^8.0.3",
    "jose": "^4.14.4",
    "jsdom": "^22.1.0",
    "lint-staged": "^13.2.3",
    "msw": "^1.2.2",
    "naive-ui": "^2.34.4",
    "nuxt": "^3.5.3",
    "nuxt-icon": "^0.4.1",
    "nuxt-lodash": "^2.4.1",
    "nuxt-scheduler": "^0.1.9",
    "playwright": "^1.35.1",
    "prisma": "^4.16.2",
    "ts-node": "^10.9.1",
    "vitest": "^0.31.4",
    "vue-tsc": "^1.8.1",
    "zod": "^3.21.4"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
